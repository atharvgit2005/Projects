{
  "id": "whatsapp-assistant-v1",
  "name": "WhatsApp AI Appointment Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-in",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ],
      "id": "node-webhook-001",
      "name": "OpenWA Webhook"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  \n  // Ignore messages sent by me (fromMe = true) and group messages\n  const fromMe = body.fromMe === true || body.id?.startsWith('true_');\n  const isGroup = body.isGroupMsg === true || (body.from && body.from.endsWith('@g.us')) || (body.chatId && body.chatId.endsWith('@g.us'));\n  \n  if (fromMe || isGroup) {\n    continue;\n  }\n  \n  const from = body.from || body.chatId || body.sender?.id || '';\n  const messageText = body.body || body.content || body.text || body.caption || '';\n  const providerMessageId = body.id || body.messageId || '';\n  const timestamp = body.timestamp ? new Date(body.timestamp * 1000).toISOString() : new Date().toISOString();\n  \n  if (!from || !messageText) {\n    continue;\n  }\n  \n  results.push({\n    json: {\n      from,\n      messageText,\n      providerMessageId,\n      timestamp\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ],
      "id": "node-normalize-002",
      "name": "Normalize Payload"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.processedIds = staticData.processedIds || [];\n\nconst item = $input.item;\nconst msgId = item.json.providerMessageId;\n\nif (msgId && staticData.processedIds.includes(msgId)) {\n  // Duplicate message detected, skip execution\n  return [];\n}\n\nif (msgId) {\n  staticData.processedIds.push(msgId);\n  // Maintain a fixed queue of max 1000 IDs\n  if (staticData.processedIds.length > 1000) {\n    staticData.processedIds.shift();\n  }\n}\n\nreturn [$input.item];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        300
      ],
      "id": "node-dedupe-003",
      "name": "Check Duplicate"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.messageText }}",
        "options": {
          "systemMessage": "=You are a friendly appointment booking assistant for a small business over WhatsApp. Keep replies short and conversational (WhatsApp style, no markdown). Use the Google Calendar tool to check availability before offering times, and to create, reschedule, or cancel appointments. After you CONFIRM a booking, log it to the Google Sheet with the Sheets tool. Never double-book. Always confirm date, time, and the customer's name before booking. If asked something unrelated to appointments, answer briefly and steer back to booking. Today's date/time in Asia/Kolkata timezone is {{ $now.setZone('Asia/Kolkata').format('yyyy-MM-dd HH:mm:ss ZZZZ') }}."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        760,
        300
      ],
      "id": "node-ai-agent-004",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        660,
        520
      ],
      "id": "node-model-005",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $('Normalize Payload').item.json.from }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        780,
        520
      ],
      "id": "node-memory-006",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "calendarId": "={{ $env.CALENDAR_ID || 'primary' }}"
      },
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        900,
        520
      ],
      "id": "node-tool-calendar-007",
      "name": "Google Calendar Tool",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "GOOGLE_CALENDAR_CREDENTIAL_ID",
          "name": "Google Calendar OAuth2"
        }
      }
    },
    {
      "parameters": {
        "documentId": "={{ $env.SPREADSHEET_ID }}",
        "sheetName": "bookings"
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1020,
        520
      ],
      "id": "node-tool-sheets-008",
      "name": "Google Sheets Tool",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWA_API_URL || 'http://localhost:8080' }}{{ $env.OPENWA_SEND_PATH || '/sendText' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{ $env.OPENWA_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"args\": {\n    \"to\": \"{{ $('Normalize Payload').item.json.from }}\",\n    \"content\": \"{{ $json.output }}\"\n  }\n}",
        "options": {
          "retry": {
            "retry": {
              "maxTries": 3,
              "waitBetweenTries": 1000
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ],
      "id": "node-send-009",
      "name": "Send OpenWA Reply"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "id": "node-error-trigger-012",
      "name": "Workflow Error Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENWA_API_URL || 'http://localhost:8081' }}{{ $env.OPENWA_SEND_PATH || '/sendText' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "={{ $env.OPENWA_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"args\": {\n    \"to\": \"{{ $('Normalize Payload').item.json?.from || $json.execution?.error?.node?.name || 'unknown' }}\",\n    \"content\": \"Sorry, I hit an issue, please try again.\"\n  }\n}",
        "options": {
          "retry": {
            "retry": {
              "maxTries": 2,
              "waitBetweenTries": 1000
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        100
      ],
      "id": "node-error-send-010",
      "name": "Send Graceful Error Reply"
    },
    {
      "parameters": {
        "documentId": "={{ $env.SPREADSHEET_ID }}",
        "sheetName": "errors",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd HH:mm:ss') }}",
            "from": "={{ $('Normalize Payload').item.json?.from || 'unknown' }}",
            "error": "={{ $json.execution?.error?.message || $json.message || 'Workflow execution error' }}",
            "failed_node": "={{ $json.execution?.error?.node?.name || 'unknown' }}"
          }
        }
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        540,
        100
      ],
      "id": "node-error-log-011",
      "name": "Log Error to Sheets",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    }
  ],
  "connections": {
    "OpenWA Webhook": {
      "main": [
        [
          {
            "node": "Normalize Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "Check Duplicate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Duplicate": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Google Calendar Tool": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets Tool": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Send OpenWA Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Workflow Error Trigger": {
      "main": [
        [
          {
            "node": "Send Graceful Error Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Graceful Error Reply": {
      "main": [
        [
          {
            "node": "Log Error to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
